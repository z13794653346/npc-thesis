DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
NPC_DEBUG=false
NPC_DEBUG_TOKEN=
NPC_DB_PATH=data/npc.sqlite3
# Optional SQLAlchemy URL; empty keeps NPC_DB_PATH. PostgreSQL uses the postgres extra.
NPC_DATABASE_URL=
# hybrid uses local embeddings when prepared, otherwise reports lexical_fallback.
NPC_MEMORY_MODE=hybrid
NPC_EMBEDDING_CACHE=artifacts/embedding-models
