    "scene": {
      "version": "hotel-1.0",
      "title": "第五位住客",
      "intro": "23:17，暴雨冲断了山路。旅店登记簿上只有四位住客，楼上却响起第五次敲门声。林掌柜坚持没有空房，维修员刚从停电的东翼回来，一名旅客说她见过你的签名。你需要查清：那一间未登记的房里，究竟住着谁？",
      "npcs": {
        "owner": {
          "name": "林掌柜",
          "role": "店主",
          "description": "守着登记簿，话不多。比起解释，他更在意你能否守约。",
          "style": "克制、谨慎、短句；不凭空指控他人。"
        },
        "mechanic": {
          "name": "周衡",
          "role": "维修员",
          "description": "袖口湿透，手里攥着断电前的维修记录。",
          "style": "务实，重视时间和证据，不猜测别人的秘密。"
        },
        "traveler": {
          "name": "沈岚",
          "role": "旅客",
          "description": "一直望着楼梯。她记得一件别人都否认的小事。",
          "style": "敏锐但不确定，明确区分亲眼所见与推测。"
        }
      },
      "clues": {
        "registry": {
          "title": "被撕去的登记页",
          "text": "登记簿写着四位住客，但第五行留下了转印字迹：东翼房间，收件人不是客人，而是旅店自己。",
          "source": "owner",
          "verified": true
        },
        "maintenance": {
          "title": "东翼维修记录",
          "text": "铜铃-731：东翼的门铃在23:00后由备用线路每隔十七分钟触发，房间已被改为旧信件保管室。",
          "source": "mechanic",
          "verified": true
        },
        "sighting": {
          "title": "雨衣上的姓名",
          "text": "沈岚亲眼看到送信人把一封署着你姓名的旧信塞进东翼门缝，信封日期是二十年前。她未见房里有人。",
          "source": "traveler",
          "verified": true
        }
      },
      "tasks": {
        "register": {
          "title": "帮店主核对大厅登记数量",
          "npc_id": "owner"
        },
        "sandbags": {
          "title": "帮店主把防汛沙袋移到门口",
          "npc_id": "owner"
        }
      },
      "aliases": {
